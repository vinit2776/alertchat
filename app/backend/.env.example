# Server
PORT=3001

# Claude AI (get from https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-YOUR_KEY_HERE
NODE_ENV=development

# CHI UAT Base URL
CHI_BASE_URL=https://apiuat.careinsurance.com

# Partner credentials (provided by CHI Tech team)
CHI_PARTNER_ID=YOUR_PARTNER_ID
CHI_SECURITY_KEY=YOUR_SECURITY_KEY
CHI_BASE_AGENT_ID=YOUR_BASE_AGENT_ID

# Care Enhance quotation credentials
CHI_API_KEY=YOUR_API_KEY
CHI_AUTH_SECRET=YOUR_AUTH_SECRET
CHI_ABACUS_ID=YOUR_ABACUS_ID

# CKYC credentials
CHI_APP_ID=YOUR_APP_ID
CHI_PARTNER_CODE=YOUR_PARTNER_CODE
CHI_PUBLIC_KEY=YOUR_PUBLIC_KEY

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# JWT Auth (generate a long random secret for production)
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES=8h

# App Users (JSON array — omit to use built-in defaults admin/agent with password "admin123")
# APP_USERS=[{"id":"u1","username":"admin","email":"admin@example.com","role":"admin","password":"securepass"},{"id":"u2","username":"agent1","email":"agent1@example.com","role":"user","password":"agentpass"}]
