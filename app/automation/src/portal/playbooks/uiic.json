{
  "portal_id": "uiic",
  "name": "United India Insurance Company",
  "base_url": "https://www.uiic.in",
  "insurance_type": "motor",

  "login": {
    "url": "/GCWebPortal/login/LoginAction.do?p=login",
    "username_field": "#username",
    "password_field": "#password",
    "submit": "button.login100-form-btn",
    "success_indicator": ".navbar-fixed-top, .navbar-inverse, #wrapper",
    "dismiss_modals": [
      "#cgw_action_btn",
      "button.close",
      "#speakClose",
      "[data-dismiss=modal]"
    ],
    "captcha": {
      "image_selector": "#captchaImg",
      "input_selector": "#userCaptcha"
    }
  },

  "_note": "Quote flow uses the Motor Premium Calculator at /CustomerPortalWeb/PremiumCalculator/. Selectors confirmed via JS inspection on 2026-05-29. #cubicCapacity re-uses same id for both CC bands (petrol) and KW bands (electric) — Angular swaps options when battery-operated checkbox is ticked. businessType select has no id/name; selected by select.my_control:not([id]).",

  "excluded_conditions": [
    {
      "field":   "is_electric",
      "value":   "true",
      "message": "UIIC Motor Premium Calculator does not support electric vehicles. The GI catalogue used by UIIC's backend does not contain EV manufacturer/model codes. Please request a quote from a different insurer for this vehicle."
    }
  ],

  "quote_flow": [
    {
      "step_id": "navigate_to_calculator",
      "label": "Navigate to Motor Premium Calculator",
      "fields": [],
      "navigate_url": "/CustomerPortalWeb/PremiumCalculator/data/MotorQuote.html#/motorQuote?agentId=ALELTD004&agentCode=BRC000025200004",
      "wait_after": "#vehicleType"
    },
    {
      "step_id": "select_vehicle_type",
      "label": "Select Business Type and Vehicle Type",
      "delay_ms": 800,
      "fields": [
        {
          "name": "Business Type",
          "selector": "select:has(option[value='Renewal'])",
          "source": "computed.business_type",
          "type": "select",
          "valueMap": {
            "new":       "New",
            "New":       "New",
            "renewal":   "Renewal",
            "Renewal":   "Renewal",
            "pre_owned": "Renewal",
            "used":      "Renewal"
          }
        },
        {
          "name": "Vehicle Type",
          "selector": "#vehicleType",
          "source": "computed.vehicle_type_code",
          "type": "select",
          "valueMap": {
            "private_car": "18",
            "two_wheeler": "3",
            "motorcycle":  "3",
            "scooter":     "3",
            "pc":          "18"
          }
        }
      ],
      "next_trigger": {
        "selector": "[name='choosePlan']:has-text('Ok'), button:has-text('Ok')",
        "action": "click"
      },
      "wait_after": "#dateOfIssueOfPolicyString"
    },
    {
      "step_id": "quote_details",
      "label": "Policy Details & Premium Calculation",
      "delay_ms": 600,
      "fields": [
        {
          "name": "Risk Start Date",
          "selector": "#dateOfIssueOfPolicyString",
          "source": "computed.risk_start_date",
          "type": "text"
        },
        {
          "name": "Date of Registration",
          "selector": "#dateOfPurchaseString",
          "source": "rc.registration_date",
          "type": "text"
        },
        {
          "name": "NCB",
          "selector": "#selectPrevNCB",
          "source": "chat.ncb_percent",
          "type": "select",
          "valueMap": {
            "0":   "0",
            "0%":  "0",
            "20":  "20",
            "20%": "20",
            "25":  "25",
            "25%": "25",
            "35":  "35",
            "35%": "35",
            "45":  "45",
            "45%": "45",
            "50":  "50",
            "50%": "50"
          },
          "optional": true
        },
        {
          "name": "Battery Operated",
          "selector": "input.checkBox1.checkbox-inline",
          "source": "computed.is_electric",
          "type": "checkbox",
          "optional": true
        },
        {
          "name": "Cubic Capacity / KW Band",
          "selector": "#cubicCapacity",
          "source": "computed.cc_band",
          "type": "select",
          "_note_options": "Options differ by vehicle type. Two-wheeler: 70/150/350/400. Car: 1000/1500/2000. EV: 3/7/16/30/65/100. field-computer computes the right option value — this valueMap is for human aliases.",
          "valueMap": {
            "below_1000":     "1000",
            "upto_1000":      "1000",
            "upto_1500":      "1500",
            "above_1500":     "2000",
            "1000":           "1000",
            "1500":           "1500",
            "2000":           "2000",
            "upto_3kw":       "3",
            "4_to_7kw":       "7",
            "8_to_16kw":      "16",
            "17_to_30kw":     "30",
            "31_to_65kw":     "65",
            "above_65kw":     "100",
            "exceeding_65kw": "100",
            "3":   "3",
            "7":   "7",
            "16":  "16",
            "30":  "30",
            "65":  "65",
            "100": "100",
            "70":  "70",
            "150": "150",
            "350": "350",
            "400": "400"
          }
        },
        {
          "name": "Vehicle Zone",
          "selector": "#vehicleZone",
          "source": "computed.vehicle_zone",
          "type": "select",
          "valueMap": {
            "A":      "Zone-A",
            "B":      "Zone-B",
            "C":      "Zone-C",
            "Zone-A": "Zone-A",
            "Zone-B": "Zone-B",
            "Zone-C": "Zone-C"
          }
        },
        {
          "name": "IDV (EV)",
          "selector": "#iibAutoRiskIdv",
          "source": "chat.idv",
          "type": "text",
          "optional": true
        },
        {
          "name": "IDV (ICE)",
          "selector": "#autoRiskIdv",
          "source": "chat.idv",
          "type": "text",
          "optional": true
        },
        {
          "name": "OD Discount",
          "selector": "#odDisc",
          "source": "chat.od_discount",
          "type": "text",
          "optional": true
        }
      ],
      "next_trigger": {
        "selector": "button:has-text('Click To See Premium')",
        "action": "click"
      },
      "wait_after": ".jconfirm-box"
    },
    {
      "step_id": "confirm_cpa_waiver",
      "label": "Confirm skipping Personal Accident Cover (jConfirm YES)",
      "delay_ms": 300,
      "fields": [],
      "next_trigger": {
        "selector": ".jconfirm-box button:has-text('YES'), .jconfirm-box button:has-text('Yes')",
        "action": "click"
      },
      "wait_after": "table.table-bordered, .panel-success, #premiumDetails"
    }
  ],

  "quote_result": {
    "result_page_indicator": "table.table-bordered, .panel-success, #premiumDetails",
    "premium_selector": "table.table-bordered tbody tr:first-child td:last-child, table.table-bordered tr:last-child td:last-child",
    "idv_selector": "td:has-text('IDV') + td, .idv-amount",
    "full_page_screenshot": true
  }
}
