# ── Alert Automation — environment variables ────────────────────────────────
# Copy this to .env for local dev.
# On Railway: set these in the Railway dashboard → Variables.

PORT=4001
NODE_ENV=production

# JWT — MUST match app/backend JWT_SECRET exactly
JWT_SECRET=replace-with-a-long-random-string

# Frontend origin (used for CORS in production)
FRONTEND_URL=https://frontend-five-rho-16.vercel.app

# PostgreSQL — on Railway this is auto-set by the Postgres addon
# Local: postgresql://localhost:5432/alertquote
DATABASE_URL=postgresql://user:pass@host:5432/dbname

# Anthropic API key
ANTHROPIC_API_KEY=sk-ant-api03-...

# Portal credentials — base64(JSON) per portal
PORTAL_CREDS_UIIC=eyJ1c2VybmFtZSI6Ii4uLiIsInBhc3N3b3JkIjoiLi4uIn0=

# AWS (optional — only needed for S3 screenshot storage)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=alert-insurance-quotes
